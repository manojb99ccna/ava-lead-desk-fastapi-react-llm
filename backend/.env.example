# ---- Copy to backend/.env and change the secrets ----
APP_ENV=development
CORS_ORIGINS=http://localhost:5190,http://localhost:5173

# Database (DB_HOST=db inside Docker, 127.0.0.1 with port 3335 from your PC)
DB_HOST=db
DB_PORT=3306
DB_NAME=ava_ai
DB_USER=ava
DB_PASSWORD=change-me

# JWT: at least 32 random characters, e.g.  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRE_MINUTES=480

# First admin user, created only when the admins table is empty
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Rate limits (requests per minute per IP)
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_BOOKING_PER_MINUTE=10

# Local LLM, runs inside the backend: no API key, no paid service.
# LLM_PROVIDER=none -> rule-based Ava only (intent model + FAQ + flows)
LLM_PROVIDER=local
# 0.5B needs ~2 GB RAM; 1.5B (better) needs ~6.5 GB RAM or a GPU
LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
LLM_DEVICE=auto
LLM_CACHE_DIR=/app/llm_models/hub
LLM_THREADS=3
LLM_MAX_NEW_TOKENS=256
LLM_TIMEOUT_SECONDS=45
LLM_TEMPERATURE=0
LLM_HISTORY_MESSAGES=10
# hybrid: intent model answers clear messages instantly, LLM handles unclear/detailed ones
LLM_MODE=hybrid
LLM_ROUTE_CONFIDENCE=0.70
LLM_ROUTE_MAX_WORDS=14

# Redacted chat debug logs in backend/logs/
CHAT_DEBUG_LOGS=false
RUN_MIGRATIONS_ON_STARTUP=true
SEED_ON_STARTUP=true
